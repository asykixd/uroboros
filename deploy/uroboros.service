# systemd user service: ~/.config/systemd/user/uroboros.service
#   systemctl --user enable --now uroboros
#   journalctl --user -u uroboros -f
# To keep the service running while logged out: sudo loginctl enable-linger $USER
[Unit]
Description=Uroboros Telegram userbot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/uroboros
# --cli: without a session the service fails with a clear journal error instead of starting the web panel.
ExecStart=%h/uroboros/.venv/bin/python -m uroboros --cli
Environment=PYTHONUNBUFFERED=1
StandardInput=null
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
